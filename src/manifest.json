{
  "manifest_version": 3,
  "name": "ЗборКО",
  "version": "1.2",
  "description": "Објаснување значење на зборови со селекција",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://api-inference.huggingface.co/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["index.js"],
      "css": ["index.css"]
    }
  ]
}
