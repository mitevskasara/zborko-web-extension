{
  "name": "zborko-web-extension",
  "version": "1.3.0",
  "description": "Firefox extension that explains the meaning of Macedonian words selected on any web page.",
  "keywords": [
    "firefox-extension",
    "manifest-v3",
    "macedonian",
    "dictionary",
    "language-learning"
  ],
  "author": "mitevskasara",
  "license": "ISC",
  "homepage": "https://github.com/mitevskasara/zborko-web-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitevskasara/zborko-web-extension.git"
  },
  "bugs": {
    "url": "https://github.com/mitevskasara/zborko-web-extension/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:firefox",
    "build:firefox": "npx --yes web-ext build --source-dir=src --artifacts-dir=dist --overwrite-dest --filename='zborko-firefox-{version}.zip'"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
